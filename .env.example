# ============================================
# DJANGO CORE
# ============================================
SECRET_KEY=your-very-long-and-random-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.local

# ============================================
# DATABASE (PostgreSQL) - Supabase or local
# ============================================
# Local PostgreSQL (for development):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/freelanceflow

# Supabase PostgreSQL (for production):
# Format: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/freelanceflow
DATABASE_NAME=freelanceflow
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# ============================================
# REDIS (Celery Broker & Result Backend) - Upstash
# ============================================
# Local Redis (for development):
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Upstash Redis REST API (optional, for direct REST access):
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# ============================================
# PAYMENT GATEWAY (Razorpay)
# ============================================
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ============================================
# LLM INTEGRATION (Groq)
# ============================================
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=llama3-70b-8192

# ============================================
# AI EMBEDDINGS (Google Gemini)
# ============================================
GEMINI_API_KEY=your_gemini_api_key
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ============================================
# AI MONITORING (LangChain / LangSmith)
# ============================================
LANGCHAIN_API_KEY=lsv2_pt_your_langchain_api_key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=FreelanceFlow
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Legacy LangSmith env vars (keep for compatibility):
LANGSMITH_API_KEY=lsv2_pt_your_langsmith_api_key
LANGSMITH_PROJECT=freelanceflow
LANGSMITH_TRACING=True

# ============================================
# SEARCH (Elasticsearch)
# ============================================
ELASTICSEARCH_URL=http://localhost:9200

# ============================================
# EMAIL (SMTP)
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=noreply@freelanceflow.com

# ============================================
# OAUTH (Google)
# ============================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================
# AZURE BLOB STORAGE (for media/file uploads)
# ============================================
# Leave empty to fall back to local media storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account;AccountKey=your_key;EndpointSuffix=core.windows.net
AZURE_CONTAINER_NAME=media

# ============================================
# FRONTEND & CORS
# ============================================
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================
# BUSINESS LOGIC
# ============================================
PLATFORM_CUT_PERCENTAGE=10
